# Publisher-only: copy to `.env` and fill in before building Tangent.
# End users never see these — they only click "Connect Google Calendar" in Settings.
#
# Google Cloud → APIs & Services → Credentials → OAuth client (Desktop app recommended)
VITE_GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional — Web application clients only (leave empty for Desktop clients)
# VITE_GOOGLE_OAUTH_CLIENT_SECRET=
