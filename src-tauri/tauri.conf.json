{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tangent",
  "version": "1.0.5",
  "identifier": "com.tangent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tangent",
        "width": 920,
        "height": 660,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "visible": true,
        "center": true
      },
      {
        "label": "capture",
        "title": "Tangent Capture",
        "width": 268,
        "height": 76,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "center": true,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/32x32.png",
      "tooltip": "Tangent"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg"],
    "shortDescription": "Catch stray thoughts without leaving your flow.",
    "longDescription": "Tangent is a local-first desktop app. Hold a hotkey to capture voice or type quick notes with work context, then triage them later.",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": [
      "resources/models/ggml-base.en.bin"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1MENGRTY5OEIxRTM5MzAKUldRd09SNkxhZjRNNVlvRlZPR0hxaXo3SDBOUVg4UytERWlSY3NraURUNVM0V2hEMkdnOHovRVcK",
      "endpoints": [
        "https://github.com/KriishT/Tangent/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
